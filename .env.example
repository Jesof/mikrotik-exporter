# Copy to a private .env; replace placeholders before starting the exporter.
# HTTP has no built-in authentication or TLS. Bind privately or use a protected proxy.
SERVER_ADDR=127.0.0.1:9090

# Preferred router JSON. {} enables verified TLS using system roots.
# For a private CA add "ca_file":"/etc/mikrotik-exporter/router-ca.pem" inside tls.
# server_name overrides the address host used for certificate verification.
ROUTERS_CONFIG='[{"name":"edge-router","address":"192.0.2.1:8729","username":"prometheus","password":"REPLACE_WITH_A_STRONG_SECRET","tls":{"server_name":"router.example.net"}}]'

# Legacy single router: unset ROUTERS_CONFIG before using these variables.
# ROUTEROS_ADDRESS=192.0.2.1:8729
# ROUTEROS_USERNAME=prometheus
# ROUTEROS_PASSWORD=REPLACE_WITH_A_STRONG_SECRET
# ROUTEROS_TLS='{"server_name":"router.example.net"}'
# Omitted/null router tls, or unset legacy ROUTEROS_TLS, means plaintext even on 8729.
# Plaintext API exposes credentials; use verified TLS or an encrypted management path.

# Integer seconds; valid ranges: 1..86400, 1..604800, 1..300 respectively.
COLLECTION_INTERVAL_SECONDS=30
GAP_RESET_THRESHOLD_SECONDS=60
STARTUP_CONNECTIVITY_TIMEOUT_SECS=10

# Booleans are exactly true/false. Strict mode requires startup tests and >=1 router.
STARTUP_CONNECTIVITY_TEST=false
STRICT_STARTUP_MODE=false
RUST_LOG=info

# Malformed/unknown JSON fields, duplicate names, or invalid values fail startup.
# Invalid ROUTERS_CONFIG never falls back to legacy variables.
